{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-pack:schema:preflight-report",
  "title": "Preflight report",
  "description": "Отчёт preflight до первых правок. Handbook 8.1, 8.2, 8.3; collision classes — 13.1.",
  "type": "object",
  "properties": {
    "ticket": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCOMPLETE"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Полный SHA коммита"
        }
      },
      "required": [
        "ref",
        "sha"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "ownership": {
      "type": "string",
      "minLength": 1
    },
    "local_state": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "clean",
            "dirty"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCOMPLETE"
          ]
        },
        "check": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "result"
      ],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "level",
        "reason"
      ],
      "additionalProperties": false
    },
    "docs_impact": {
      "type": "string",
      "minLength": 1
    },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "with": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "isolated",
              "file overlap only",
              "contract dependency",
              "direct conflict",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "with",
          "class",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "merge_order": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCOMPLETE"
      ]
    }
  },
  "required": [
    "ticket",
    "readiness",
    "repository",
    "base",
    "branch",
    "ownership",
    "local_state",
    "environment",
    "risk",
    "docs_impact",
    "collisions",
    "merge_order",
    "plan",
    "result"
  ],
  "additionalProperties": false
}
