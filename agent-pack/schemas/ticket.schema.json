{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-pack:schema:ticket",
  "title": "Ticket",
  "description": "Исполнимый тикет. Handbook 6.1 (контракт задачи), 6.2 (Definition of Ready).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "risk": {
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "docs_impact_expectation": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "outcome",
    "scope",
    "out_of_scope",
    "acceptance_criteria",
    "dependencies",
    "source_docs",
    "risk",
    "docs_impact_expectation",
    "owner",
    "branch",
    "delivery",
    "validation"
  ],
  "additionalProperties": false
}
