{
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.openai/**)",
      "Write(.openai/**)",
      "Edit(src/content/generated.json)",
      "Write(src/content/generated.json)",
      "Edit(public/handbook.md)",
      "Write(public/handbook.md)",
      "Edit(public/data/**)",
      "Write(public/data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"; rc=$?; [ \"$rc\" -eq 0 ] && exit 0; [ \"$rc\" -eq 2 ] || echo \"guard-git: hook не запустился или упал (код $rc), действие заблокировано (fail closed). См. AGENTS.md.\" >&2; exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
